# IB Gateway login (used by deploy/docker-compose.yml). Use a second live
# username with its own market data subscriptions so your own IBKR sessions
# never compete with the collector.
TWS_USERID=
TWS_PASSWORD=
TRADING_MODE=live

# Collector. 4001 = live gateway, 4002 = paper gateway.
FR_IB_PORT=4001
# Where market data is stored; defaults to data/ in the repo.
# FR_DATA_ROOT=
