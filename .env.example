# IB Gateway login (used by deploy/docker-compose.yml). Use a second live
# username with its own market data subscriptions so your own IBKR sessions
# never compete with the collector.
TWS_USERID=
TWS_PASSWORD=
TRADING_MODE=live

# Collector. 4001 = live gateway, 4002 = paper gateway.
FR_IB_PORT=4001
# Paper trading (README, "Paper trading"). The paper gateway runs as a second IB Gateway on 4002,
# logged in with the paper username. Orders go out only with FR_PAPER_SEND=1; otherwise dry runs.
# FR_PAPER_ACCOUNT=DU0000000
# FR_PAPER_PORT=4002
# FR_PAPER_SEND=1

# Where market data is stored; defaults to data/ in the repo.
# FR_DATA_ROOT=
