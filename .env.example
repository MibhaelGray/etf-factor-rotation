# IB Gateway login (used by deploy/docker-compose.yml). A paper login with live
# market data shared to it avoids 2FA and never trades real money.
TWS_USERID=
TWS_PASSWORD=
TRADING_MODE=paper

# Collector. 4002 = paper gateway, 4001 = live gateway.
FR_IB_PORT=4002
FR_DATA_ROOT=s3://your-bucket/factor-rotation
AWS_DEFAULT_REGION=us-east-1
